# Marketplace Buyer Interface Environment Variables
# Copy this file to .env and fill in the values

# WhatsApp Configuration (for order delivery to sellers)
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token_here
WHATSAPP_API_ENDPOINT=https://graph.facebook.com/v22.0

# DynamoDB Configuration
PRODUCTS_TABLE_NAME=marketplace-products
CART_SESSIONS_TABLE_NAME=marketplace-cart-sessions

# API Gateway Configuration
API_GATEWAY_ENDPOINT=https://your-api-gateway-url.amazonaws.com/prod

# AWS Region
AWS_REGION=us-east-1

# Frontend Configuration
# Base URL for API calls (used by frontend)
API_BASE_URL=https://your-api-gateway-url.amazonaws.com/prod

# Feature Flags
ENABLE_REAL_TIME_UPDATES=true
POLLING_INTERVAL_MS=5000

# Order Configuration
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_MS=1000
